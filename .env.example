# CONFIG DETECTIVE - environment variables template
# 1. Copy this file to ".env" (which is gitignored)
# 2. Fill in your real keys below
# 3. NEVER commit .env to git

# ----- LLM providers -----
# Groq is the primary reasoning LLM (free, fast). Get key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini is the fallback if Groq is rate-limited. Get key: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace Inference is used for embeddings (bge-large) and code-LLM (Qwen2.5-Coder).
# Get token: https://huggingface.co/settings/tokens (Read scope is sufficient)
HF_TOKEN=your_huggingface_token_here

# ----- Database -----
# Supabase project URL and keys. Get from: Project Settings -> API
# Make sure pgvector extension is enabled (Database -> Extensions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----- Optional: GitHub PAT for higher rate limits during multi-source RAG -----
# Only needed if you hit rate limits during Phase 4 development.
# Get token: https://github.com/settings/tokens (no scopes needed for public repo search)
GITHUB_TOKEN=

# ----- Runtime config -----
# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Max sandbox runs per investigation (guardrail)
MAX_SANDBOX_RUNS=10

# Max wall-clock time per investigation in seconds (guardrail)
MAX_INVESTIGATION_SECONDS=300

# Default operating mode: "propose" (default) or "apply"
DEFAULT_MODE=propose
